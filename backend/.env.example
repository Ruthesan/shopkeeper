# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://shopkeeper:shopkeeper@localhost:5432/shopkeeper_db

# ── AI ────────────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-api03-your-key-here

# ── Auth (CHANGE THESE IN PRODUCTION) ────────────────────────────────────────
# Generate a strong key: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-this-to-a-64-char-random-string-before-deploying

# ── CORS (comma-separated list of allowed frontend origins) ──────────────────
# In production: set this to your actual frontend URL
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ── Environment ───────────────────────────────────────────────────────────────
# Set to "production" to hide /docs endpoint
ENVIRONMENT=development
